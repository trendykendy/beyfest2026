# Where PocketBase is. Normally leave this unset: the app server uses
# http://127.0.0.1:8090 (the same machine) and each browser uses port 8090 on
# whatever address it opened the page from, so the TV and phones keep working
# when the network or the machine's IP changes. Set it only if PocketBase runs
# on a different machine from the web app.
# PUBLIC_PB_URL=http://192.168.1.20:8090

# ── Local dev credentials (seeded into a fresh pb_data by the migrations) ──
# Organiser login (used in the web app):   organiser@beyfest.local / beyfest2026
# PocketBase superuser (admin console /_/): admin@beyfest.local     / beyfestadmin2026
# Change these from the PocketBase admin console before a real event.
