# The web app talks to PocketBase at this URL. start.ps1 sets it automatically
# to the laptop's LAN IP so phones on the venue wifi get live updates. Only set
# it by hand if you run the web app without start.ps1 (e.g. plain `bun run dev`,
# where the default http://127.0.0.1:8090 is correct for the laptop itself).
PUBLIC_PB_URL=http://127.0.0.1:8090

# ── Local dev credentials (seeded into a fresh pb_data by the migrations) ──
# Organiser login (used in the web app):   organiser@beyfest.local / beyfest2026
# PocketBase superuser (admin console /_/): admin@beyfest.local     / beyfestadmin2026
# Change these from the PocketBase admin console before a real event.
